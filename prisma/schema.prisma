generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// PERSONAL (existing)
// ═══════════════════════════════════════════════════════════════

model WatchedWallet {
  id        String   @id @default(cuid())
  address   String   @unique
  chain     String   @default("solana")
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  trades    Trade[]
  analytics WalletAnalytics?
}

model Trade {
  id            String   @id @default(cuid())
  whaleWallet   String
  wallet        WatchedWallet? @relation(fields: [whaleWallet], references: [address])
  tokenMint     String
  tokenSymbol   String?
  tokenDecimals Int      @default(6)

  buyTx         String
  buyPriceUsd   Decimal  @db.Decimal(18, 12)
  buyAmountUsd  Decimal  @db.Decimal(18, 6)
  buyAmountTokens Decimal @db.Decimal(36, 0)
  buyTime       DateTime @default(now())

  sellTx        String?
  sellPriceUsd  Decimal? @db.Decimal(18, 12)
  sellAmountUsd Decimal? @db.Decimal(18, 6)
  pnlPercent    Decimal? @db.Decimal(18, 4)
  sellReason    String?  // PROFIT, STOP_LOSS, MANUAL
  sellTime      DateTime?

  status        String   @default("HOLDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  feeTracking   FeeTracking?
}

model Settings {
  id            String   @id @default(cuid())
  tradeBudget   Decimal  @default(6.00) @db.Decimal(18, 6)
  takeProfit    Decimal  @default(50.00) @db.Decimal(18, 4)
  stopLoss      Decimal  @default(-30.00) @db.Decimal(18, 4)
  slippageBps   Int      @default(200)
  minWhaleBuy   Decimal  @default(100.00) @db.Decimal(18, 6)
  isRunning     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// GROUP (NEW)
// ═══════════════════════════════════════════════════════════════

model Group {
  id          String   @id @default(cuid())
  groupId     String   @unique  // Telegram group chat ID (e.g. -100123...)
  groupName   String?
  adminId     String   // Telegram user ID who added the bot
  isActive    Boolean  @default(true)

  wallets     GroupWallet[]
  members     GroupMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupWallet {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  address     String
  label       String?
  isActive    Boolean  @default(true)
  addedBy     String   // Admin user ID
  createdAt   DateTime @default(now())

  @@unique([groupId, address])
  @@index([groupId])
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  userChatId  String   // Their private chat ID
  username    String?
  firstName   String?

  tradeBudget Decimal  @default(6.00) @db.Decimal(18, 6)
  takeProfit  Decimal  @default(50.00) @db.Decimal(18, 4)
  stopLoss    Decimal  @default(-30.00) @db.Decimal(18, 4)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, userChatId])
  @@index([groupId])
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS & DISCOVERY (existing)
// ═══════════════════════════════════════════════════════════════

model WalletAnalytics {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  wallet          WatchedWallet @relation(fields: [walletAddress], references: [address])
  totalTrades     Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  winRate         Decimal  @default(0) @db.Decimal(5, 2)
  avgPnlPercent   Decimal  @default(0) @db.Decimal(18, 4)
  totalPnlPercent Decimal  @default(0) @db.Decimal(18, 4)
  externalPnl24h   Decimal? @db.Decimal(18, 4)
  externalPnl7d    Decimal? @db.Decimal(18, 4)
  externalPnl30d   Decimal? @db.Decimal(18, 4)
  externalVolume24h Decimal? @db.Decimal(18, 6)
  externalTradeCount24h Int?
  walletTags      String[]
  netWorthSol     Decimal? @db.Decimal(18, 9)
  score           Decimal  @default(0) @db.Decimal(18, 4)
  rank            Int?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DiscoveredWallet {
  id            String   @id @default(cuid())
  address       String
  source        String
  tokenMint     String?
  tokenSymbol   String?
  pnl24h        Decimal? @db.Decimal(18, 4)
  pnl7d         Decimal? @db.Decimal(18, 4)
  volume24h     Decimal? @db.Decimal(18, 6)
  tradeCount24h Int?
  walletTags    String[]
  netWorthSol   Decimal? @db.Decimal(18, 9)
  isAdded       Boolean  @default(false)
  addedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([source, createdAt])
  @@index([address])
}

model TrendingToken {
  id          String   @id @default(cuid())
  tokenMint   String   @unique
  tokenSymbol String?
  tokenName   String?
  priceUsd    Decimal? @db.Decimal(18, 12)
  volume24h   Decimal? @db.Decimal(18, 6)
  marketCap   Decimal? @db.Decimal(18, 6)
  liquidity   Decimal? @db.Decimal(18, 6)
  priceChange24h Decimal? @db.Decimal(18, 4)
  topTraderAddresses String[]
  discoverySource    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeeTracking {
  id          String   @id @default(cuid())
  tradeId     String?  @unique
  trade       Trade?   @relation(fields: [tradeId], references: [id])

  tokenMint   String
  tokenSymbol String?

  feeAmount   Decimal  @db.Decimal(36, 0)  // Raw token amount
  feeAmountUsd Decimal @db.Decimal(18, 6)   // USD value at time of trade
  feeBps      Int      // Fee rate used (e.g. 20)

  txid        String   // The swap transaction

  claimed     Boolean  @default(false)
  claimedAt   DateTime?

  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// USER REFERRAL & VIRAL GROWTH SYSTEM
// ═══════════════════════════════════════════════════════════════

model ReferralUser {
  id                 String   @id @default(cuid())
  userChatId         String   @unique
  username           String?
  firstName          String?
  referredBy         String?  // Referrer userChatId
  totalVolumeUsd     Decimal  @default(0) @db.Decimal(18, 6)
  totalEarningsUsd   Decimal  @default(0) @db.Decimal(18, 6)
  unclaimedEarningsUsd Decimal @default(0) @db.Decimal(18, 6)
  payoutWallet       String?  // Solana wallet to receive referral commission

  rewardsReceived    ReferralReward[] @relation("ReferrerRewards")
  rewardsGenerated   ReferralReward[] @relation("ReferredRewards")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([referredBy])
}

model ReferralReward {
  id               String   @id @default(cuid())
  referrerChatId   String
  referrer         ReferralUser @relation("ReferrerRewards", fields: [referrerChatId], references: [userChatId], onDelete: Cascade)
  
  referredChatId   String
  referred         ReferralUser @relation("ReferredRewards", fields: [referredChatId], references: [userChatId], onDelete: Cascade)

  tradeId          String?
  tradeVolumeUsd   Decimal  @db.Decimal(18, 6)
  feeAmountUsd     Decimal  @db.Decimal(18, 6)
  rewardAmountUsd  Decimal  @db.Decimal(18, 6)
  rewardPercent    Decimal  @default(20.00) @db.Decimal(5, 2) // 20% of the platform fee

  createdAt        DateTime @default(now())

  @@index([referrerChatId])
  @@index([referredChatId])
}

// ═══════════════════════════════════════════════════════════════
// ALPHAPOINTS GAMIFICATION & REWARDS SYSTEM
// ═══════════════════════════════════════════════════════════════

model UserPoints {
  id                 String   @id @default(cuid())
  userChatId         String   @unique
  username           String?
  firstName          String?
  totalPoints        Int      @default(0)
  currentStreak      Int      @default(0)
  lastDailyClaim     DateTime?
  totalTrades        Int      @default(0)
  totalWins          Int      @default(0)
  totalReferrals     Int      @default(0)
  tier               String   @default("Bronze")

  history            PointsLedger[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([totalPoints])
}

model PointsLedger {
  id               String      @id @default(cuid())
  userChatId       String
  user             UserPoints  @relation(fields: [userChatId], references: [userChatId], onDelete: Cascade)
  
  amount           Int
  action           String
  description      String?
  metadata         String?

  createdAt        DateTime    @default(now())

  @@index([userChatId])
  @@index([createdAt])
}


